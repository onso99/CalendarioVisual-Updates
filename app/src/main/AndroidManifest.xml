<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.calendario">

    <!-- Permisos para acceder a los calendarios del dispositivo -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <!-- <uses-permission android:name="android.permission.WRITE_CALENDAR"/> -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calendario"
        android:resizeableActivity="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:configChanges="screenSize|orientation|keyboardHidden"
            android:theme="@style/Theme.Calendario">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 1. Declaración del AppWidgetProvider -->
        <receiver
            android:name=".CalendarAppWidgetProvider"
            android:exported="false"
            android:label="@string/calendar_widget_description">  <!-- Puedes usar la misma string que en widget_info -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- 2. Declaración del RemoteViewsService -->
        <service
            android:name=".CalendarWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>
