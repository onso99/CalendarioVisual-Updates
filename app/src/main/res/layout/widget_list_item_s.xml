<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_list_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <TextView
        android:id="@+id/widget_item_day_of_week"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#A9A9A9"
        android:textSize="12sp"
        tools:text="Dom" />

    <TextView
        android:id="@+id/widget_item_date_formatted"
        android:layout_width="55dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="#A9A9A9"
        android:textSize="12sp"
        tools:text="28/08" />

    <TextView
        android:id="@+id/widget_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#A9A9A9"
        android:textSize="12sp"
        tools:text="Descripción del evento" />

    <ImageView
        android:id="@+id/widget_item_alarm_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/alarm"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_alarm_bell_outlined"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/widget_item_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="#A9A9A9"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="08:45"
        tools:visibility="visible" />

</LinearLayout>
