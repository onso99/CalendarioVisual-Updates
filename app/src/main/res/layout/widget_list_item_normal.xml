<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_list_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="0dp"
    android:paddingHorizontal="6dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_item_day_of_week"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:textSize="14sp"
        android:textColor="#A9A9A9"
        android:text="Mié"
        android:gravity="end"
        android:layout_marginEnd="6dp"/>

    <TextView
        android:id="@+id/widget_item_date_formatted"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:textSize="14sp"
        android:textColor="#A9A9A9"
        android:text="26/11"
        android:gravity="center"
        android:layout_marginEnd="6dp"/>

    <TextView
        android:id="@+id/widget_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-condensed"
        android:textSize="14sp"
        android:textColor="#A9A9A9"
        android:gravity="start"
        android:text="Descripción del evento muy larga para probar el wrap y el espacio"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>