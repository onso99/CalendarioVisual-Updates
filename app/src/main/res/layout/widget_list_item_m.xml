<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_list_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="1dp">

    <TextView
        android:id="@+id/widget_item_day_of_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#A9A9A9"
        android:textSize="14sp"
        tools:text="Dom" />

    <TextView
        android:id="@+id/widget_item_date_formatted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="#A9A9A9"
        android:textSize="14sp"
        tools:text="28/08" />

    <TextView
        android:id="@+id/widget_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6.7"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="#A9A9A9"
        android:textSize="14sp"
        tools:text="Descripción del evento muy larga" />

</LinearLayout>