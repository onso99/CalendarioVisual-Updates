    <string name="help_section_calendar_views">ক্যালেন্ডার ভিউ</string>
    <string name="help_calendar_views_1">অ্যাপ্লিকেশনটির দুটি প্রধান ভিউ রয়েছে: মাসিক এবং বার্ষিক। আপনি মাসিক ভিউয়ের হেডারে বছরে ট্যাপ করে তাদের মধ্যে স্যুইচ করতে পারেন।</string>
    <string name="help_calendar_views_2">মাসিক ভিউতে, মাস পরিবর্তন করতে বাম বা ডানে সোয়াইপ করুন। আপনি যদি বর্তমান মাস থেকে দূরে সরে যান, তাহলে দ্রুত ফিরে আসার জন্য উপরের বাম কোণে একটি তীর উপস্থিত হবে।</string>
    <string name="help_section_event_management">ইভেন্ট ম্যানেজমেন্ট</string>
    <string name="help_event_management_1">মাসিক ক্যালেন্ডারে একটি দিনে ট্যাপ করুন যাতে একটি ডায়ালগে তার ইভেন্টগুলি দেখতে পারেন। সেখান থেকে, আপনি সেই দিনের জন্য একটি নতুন ইভেন্ট যোগ করতে পারেন বা এটি সম্পাদনা করতে একটি বিদ্যমান ইভেন্টে ট্যাপ করতে পারেন।</string>
    <string name="help_event_management_2">আপনি উপরের বারে \'+\' আইকনে ট্যাপ করে বা ক্যালেন্ডারে একটি খালি দিনে ট্যাপ করে একটি ইভেন্ট তৈরি করতে পারেন।</string>
    <string name="help_section_event_list">ইভেন্ট তালিকা</string>
    <string name="help_event_list_1">মাসিক ক্যালেন্ডারের নীচে, মাসের ইভেন্টগুলির একটি তালিকা প্রদর্শিত হয়। বর্তমান মাসের জন্য, আপনি সমস্ত ইভেন্ট বা শুধুমাত্র বিচারাধীন ইভেন্ট (ভবিষ্যতের ইভেন্ট) দেখতে বেছে নিতে পারেন। স্যুইচ করতে \'সব\'/\'বিচারাধীন\' বোতামে ট্যাপ করুন।</string>
    <string name="help_section_customization">কাস্টমাইজেশন</string>
    <string name="help_customization_1">আপনি \'সেটিংস\' মেনু থেকে অ্যাপ্লিকেশনটির চেহারা সম্পূর্ণরূপে কাস্টমাইজ করতে পারেন। এর মধ্যে রয়েছে হালকা এবং অন্ধকার থিমের মধ্যে স্যুইচ করা এবং ইন্টারফেসের প্রতিটি রঙ পরিবর্তন করা।</string>
    <string name="help_customization_2">রঙিন থিমগুলি .json ফাইল হিসাবে রপ্তানি এবং আমদানি করা যেতে পারে, যা আপনাকে আপনার সৃষ্টিগুলি সংরক্ষণ করতে বা ভাগ করতে দেয়।</string>
    <string name="help_section_widget">উইজেট</string>
    <string name="help_widget_1">অ্যাপ্লিকেশনটিতে আপনার হোম স্ক্রিনের জন্য একটি উইজেט রয়েছে যা আসন্ন ইভেন্টগুলি প্রদর্শন করে। আপনি \'সেটিংস\' স্ক্রিন থেকে এর চেহারা (ইভেন্টের সংখ্যা, ফন্টের আকার এবং রঙ) কাস্টমাইজ করতে পারেন।</string>
